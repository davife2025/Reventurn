# Server
PORT=4000
NODE_ENV=development
# Comma-separated list of origins allowed to call this API
CORS_ORIGIN=http://localhost:3000

# Supabase (server-side — service role key, never expose to the client)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# FRED (Federal Reserve Economic Data) — free key, register at
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# OKX Web3 (Onchain OS) Market API — free tier (100K calls/month), register
# a project + API key at https://web3.okx.com/onchainos/dev-portal
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
# Optional — only some endpoints require this; leave blank otherwise
OKX_API_PROJECT_ID=

# Hugging Face Inference Providers — powers the Reventurn AI chat (Kimi K2).
# Paid/metered beyond a small free tier. Create a fine-grained token with
# "Make calls to Inference Providers" permission at
# https://huggingface.co/settings/tokens
HF_TOKEN=
# Optional — defaults to moonshotai/Kimi-K2-Instruct-0905 if unset. Set to
# pin a specific provider, e.g. moonshotai/Kimi-K2-Instruct-0905:novita
HF_CHAT_MODEL_ID=
